# Copy to .env.local and fill in before building the APK.
# NEXT_PUBLIC_* values are COMPILED INTO the bundle at build time — changing
# one requires a rebuild, and they are visible to anyone with the APK.
# Never put a secret behind a NEXT_PUBLIC_ prefix.

# --- Client (baked into the APK) ---
# The Render realtime server. Must be reachable from the phone: localhost
# only works in an emulator on your own machine.
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Realtime server (Render) ---
PORT=3001
# Comma-separated CORS allowlist. Include the Vercel URL and the Capacitor
# WebView origin (https://localhost).
ALLOWED_ORIGINS=https://beatz.vercel.app,https://localhost

# --- Data stores (not yet wired; see docs/DATA_POPULATION.md) ---
# DATABASE_URL=postgres://user:pass@host:5432/beatz
# REDIS_URL=redis://default:pass@host:6379

# --- Seeding only. Never shipped to the client. ---
# Spotify Dev Mode is capped at 5 authorized users and requires Premium
# (docs/LICENSING_RIGHTS.md §0.1), so it is seed-time only and fully
# optional — the pipeline degrades to MusicBrainz + Deezer without it.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
