*.pem
npm-debug.log*
yarn-error.log*
.vercel
*.tsbuildinfo

# Obsidian vault — personal notes, synced from the repo but never committed
# back into it. Subagents must not write here; the controller syncs at
# reviewed checkpoints only.
/Beatz/

# SDD scratch — ledger, briefs, reports, review packages
/.superpowers/
